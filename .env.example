DEBUG=true
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://practiceielts:SET_LOCALLY@127.0.0.1:5432/practiceielts
REDIS_URL=redis://127.0.0.1:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional private S3 storage (local filesystem otherwise):
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Local speech recognition (no API key). The first model download needs Hugging Face access.
WHISPER_MODEL=base.en
WHISPER_THREADS=4
WHISPER_LOCAL_ONLY=false
# Optional existing model cache directory:
# WHISPER_CACHE_DIR=/absolute/path/to/model-cache
# Optional trusted CA bundle for Docker builds; Mac default is /etc/ssl/cert.pem:
# BUILD_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# base.en and tiny.en use verified pinned model revisions by default.
# WHISPER_MODEL_REVISION=your_reviewed_model_commit
